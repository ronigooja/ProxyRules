{
  "dns": {
    "servers": [
      {"tag": "local", "type": "https", "server": "1.12.12.12", "detour": "direct"},
      {"tag": "remote", "type": "https", "server": "1.1.1.1", "detour": "🐟 其他流量"},
      {"tag": "remote-google", "type": "https", "server": "8.8.8.8", "detour": "🐟 其他流量"}
    ],
    "rules": [
      {"clash_mode": "direct", "server": "local"},
      {"clash_mode": "global", "server": "remote"}
    ],
    "final": "remote"
  },
  "inbounds": [
    {"type": "mixed", "tag": "mixed-in", "listen": "127.0.0.1", "listen_port": 12334},
    {"type": "tun", "tag": "tun-in", "interface_name": "sing-box", "address": ["172.19.0.1/30", "fdfe:dcba:9876::1/126"], "auto_route": true}
  ],
  "outbounds": [
    {"type": "direct", "tag": "direct"},
    {"type": "block", "tag": "block"}
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": {"server": "local"},
    "rules": [
      {"protocol": "dns", "action": "hijack-dns"},
      {"clash_mode": "direct", "outbound": "direct"},
      {"clash_mode": "global", "outbound": "🚀 默认代理"}
    ],
    "rule_set": [
      {"tag": "geosite-cn", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs", "download_detour": "🚀 默认代理"},
      {"tag": "geoip-cn", "type": "remote", "format": "binary", "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs", "download_detour": "🚀 默认代理"}
    ]
  }
}
